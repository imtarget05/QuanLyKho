# Cloudflare Pages / Workers Assets: Security headers cho Flutter Web
# Áp dụng cho tất cả routes
/*
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=()
  X-XSS-Protection: 1; mode=block

# Entrypoint scripts & HTML: always revalidate deployments, but allow the
# browser/Cloudflare to retain a local copy and answer with a small 304.
/index.html
  Cache-Control: no-cache, must-revalidate

/flutter_service_worker.js
  Cache-Control: no-cache, must-revalidate

/flutter_bootstrap.js
  Cache-Control: no-cache, must-revalidate

/main.dart.js
  Cache-Control: no-cache, must-revalidate

# Cache Flutter static assets lâu (hash trong tên file)
/assets/*
  Cache-Control: public, max-age=31536000, immutable

/canvaskit/*
  Cache-Control: public, max-age=31536000, immutable
