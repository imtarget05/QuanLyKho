# =============================================================================
# Dockerfile — Model Serving API (Phase M — S9)
# =============================================================================
# FastAPI inference endpoint với model đã Promotion sang Production.
# - Non-root user
# - Resource limits rõ ràng
# - Health check endpoints
# - Multi-stage build: builder → runtime
# - Model artifact pinned qua ENV
# =============================================================================
FROM python:3.11-slim AS builder

# Install system dependencies required for build
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    gcc \
    && rm -rf /var/lib/apt/lists/*

# Set working directory
WORKDIR /app

# Create non-root user
RUN groupadd --gid 1000 appuser && \
    useradd --uid 1000 --gid 1000 --create-home --shell /bin/bash appuser

# Install Python dependencies into isolated path
COPY pyproject.toml poetry.lock ./
RUN pip install --no-cache-dir poetry==2.5.1 && \
    poetry config virtualenvs.create false && \
    poetry install --only main --no-interaction --no-ansi --no-root

# =============================================================================
# Runtime stage
# =============================================================================
FROM python:3.11-slim AS runtime

# Install minimal runtime deps
RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Copy installed packages from builder
COPY --from=builder /usr/local /usr/local
# Copy application code
COPY app/ app/
COPY Dockerfile.serving .

# Create writable data directories owned by non-root user
RUN mkdir -p /data /tmp /home/appuser \
    && chown -R 1000:1000 /app /data /home/appuser

# Switch to non-root user
# Dùng numeric UID:GID (1000:1000) — kubelet chỉ verify được non-root khi
# image khai báo user dạng số, không verify được user name ("appuser").
USER 1000:1000

# Environment variables
ENV MLFLOW_TRACKING_URI="sqlite:////data/mlflow.db"
ENV MLFLOW_ARTIFACT_ROOT="/data/mlruns"
ENV _MLFLOW_SERVER_ARTIFACT_ROOT="/data/mlruns"
ENV MLFLOW_REGISTRY_DIR="/data/mlruns"
ENV MODEL_NAME="DemandForecastModel"
ENV PYTHONUNBUFFERED=1
ENV PORT=8000

# Health check
# Runtime stage không cài curl → dùng Python stdlib (urllib) để không cần package thêm.
HEALTHCHECK --interval=30s --timeout=10s --start-period=30s --retries=3 \
    CMD python -c "import urllib.request; urllib.request.urlopen('http://localhost:8000/health', timeout=5)" || exit 1

# Expose port
EXPOSE 8000

# Entry point
CMD ["uvicorn", "app.api.inference:app", "--host", "0.0.0.0", "--port", "8000"]